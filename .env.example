# Postgres — Drizzle lee esta variable tanto en la app como en drizzle-kit
DATABASE_URL="postgresql://usuario:clave@localhost:5432/invoices"

# Secreto que debe presentar el cronjob para invocar /api/cron/recurring.
# Envíalo como `Authorization: Bearer <secreto>` o `?token=<secreto>`.
CRON_SECRET="cambia-esto-por-un-secreto-largo"

# Zona horaria con la que el cron decide "hoy" (IANA). Por defecto America/Santo_Domingo.
CRON_TIMEZONE="America/Santo_Domingo"

# --- Correo (Resend) ---
# Pega aquí la clave de https://resend.com/api-keys y los correos empiezan a
# salir: con RESEND_API_KEY presente y MAIL_PROVIDER vacío, se usa Resend.
# Déjala vacía para trabajar con el proveedor simulado (imprime en consola).
RESEND_API_KEY=""

# Fuerza un proveedor concreto: "resend" o "mock". Vacío = detección automática.
MAIL_PROVIDER=""

# El dominio del remitente tiene que estar verificado en Resend.
# Sin verificar, Resend solo acepta "Acme <onboarding@resend.dev>" hacia tu propio correo.
MAIL_FROM="Facturación <facturacion@tudominio.do>"
MAIL_REPLY_TO=""

# "false" silencia todos los envíos, sea cual sea el proveedor.
MAIL_ENABLED="true"

# URL pública de la app. Se usa para los enlaces "Ver la factura" del correo.
APP_URL="http://localhost:3000"
